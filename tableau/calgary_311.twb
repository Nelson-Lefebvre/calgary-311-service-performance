<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.3.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences />
  <datasources>
  <datasource caption="Timeliness (category_monthly)" inline='true' name='federated.cm' version='18.1'>
    <connection class='federated'>
      <named-connections>
        <named-connection caption="category_monthly.csv" name='textscan.cm'>
          <connection class='textscan' directory="C:/Users/NelsonX16/Dev/projects/GitHub/Projet-311/calgary-311-service-performance/data/processed/exports" filename="category_monthly.csv" password='' server='' />
        </named-connection>
      </named-connections>
      <relation connection='textscan.cm' name="category_monthly.csv" table='[category_monthly#csv]' type='table'>
        <columns character-set='UTF-8' header='yes' locale='en_CA' separator=','>
            <column datatype='string' name="service_category" ordinal='0' />
            <column datatype='string' name="request_type" ordinal='1' />
            <column datatype='date' name="request_month" ordinal='2' />
            <column datatype='integer' name="requests" ordinal='3' />
            <column datatype='integer' name="closed_requests" ordinal='4' />
            <column datatype='real' name="median_days_to_close" ordinal='5' />
            <column datatype='real' name="p90_days_to_close" ordinal='6' />
            <column datatype='integer' name="closed_within_benchmark" ordinal='7' />
            <column datatype='integer' name="closed_with_benchmark" ordinal='8' />
            <column datatype='real' name="pct_within_benchmark" ordinal='9' />
            <column datatype='real' name="pct_within_benchmark_p90" ordinal='10' />
        </columns>
      </relation>
    </connection>
    <column datatype='string' name='[service_category]' role='dimension' type='nominal' />
    <column datatype='string' name='[request_type]' role='dimension' type='nominal' />
    <column datatype='date' name='[request_month]' role='dimension' type='ordinal' />
    <column datatype='integer' name='[requests]' role='measure' type='quantitative' />
    <column datatype='integer' name='[closed_requests]' role='measure' type='quantitative' />
    <column datatype='real' name='[median_days_to_close]' role='measure' type='quantitative' />
    <column datatype='real' name='[p90_days_to_close]' role='measure' type='quantitative' />
    <column datatype='integer' name='[closed_within_benchmark]' role='measure' type='quantitative' />
    <column datatype='integer' name='[closed_with_benchmark]' role='measure' type='quantitative' />
    <column datatype='real' name='[pct_within_benchmark]' role='measure' type='quantitative' />
    <column datatype='real' name='[pct_within_benchmark_p90]' role='measure' type='quantitative' />
    <column caption="% within benchmark" datatype='real' name='[Calculation_pct]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([closed_within_benchmark]) / SUM([closed_with_benchmark])" />
    </column>
    <column caption="Period" datatype='string' name='[Calculation_period]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="IF [request_month] &lt; #2025-01-01# THEN '2022-2024' ELSEIF [request_month] &lt;= DATEADD('month', -2, {FIXED : MAX([request_month])}) THEN '2025 on' END" />
    </column>
    <column caption="Requests in month" datatype='integer' name='[Calculation_monthtotal]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="{FIXED [request_month] : SUM([requests])}" />
    </column>
    <column caption="Full month" datatype='boolean' name='[Calculation_fullmonth]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="[request_month] &lt; {FIXED : MAX([request_month])}" />
    </column>
  <extract count='-1' enabled='true' units='records'>
    <connection access_mode='readonly' author-locale='en_US' class='hyper' dbname="C:/Users/NelsonX16/Dev/projects/GitHub/Projet-311/calgary-311-service-performance/data/processed/tableau/cm.hyper" default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau'>
      <relation name='Extract' table='[Extract].[Extract]' type='table' />
    </connection>
  </extract>
  </datasource>
