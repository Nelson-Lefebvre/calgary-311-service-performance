  <worksheets>
  <worksheet name="Headline backlog">
    <layout-options><title><formatted-text><run>Field requests open 90+ days, latest month end</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Backlog (backlog_category_monthly)" name='federated.bc' /></datasources>
        <datasource-dependencies datasource='federated.bc'>
          <column-instance column='[open_requests]' derivation='Sum' name='[sum:open_requests:qk]' pivot='key' type='quantitative' />
<column caption="Latest month end" datatype='boolean' name='[Calculation_latest]' role='dimension' type='nominal'><calculation class='tableau' formula="[month_end] = {FIXED : MAX([month_end])}" /></column>
<column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
<column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' />
<column-instance column='[Calculation_latest]' derivation='None' name='[none:Calculation_latest:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.bc].[none:request_type:nk]'>
  <groupfilter function='member' level='[none:request_type:nk]' member='"field"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bc].[none:age_band:nk]'>
  <groupfilter function='member' level='[none:age_band:nk]' member='"90+"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bc].[none:Calculation_latest:nk]'>
  <groupfilter function='member' level='[none:Calculation_latest:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
        
        <slices><column>[federated.bc].[none:request_type:nk]</column><column>[federated.bc].[none:age_band:nk]</column><column>[federated.bc].[none:Calculation_latest:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Text' />
          <encodings><text column='[federated.bc].[sum:open_requests:qk]' /></encodings>
        </pane>
      </panes>
      <rows></rows>
      <cols></cols>
    </table>
  </worksheet>
  <worksheet name="Old backlog trend">
    <layout-options><title><formatted-text><run>Field requests open 90+ days reached their highest level since 2022</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Backlog (backlog_category_monthly)" name='federated.bc' /></datasources>
        <datasource-dependencies datasource='federated.bc'>
          <column-instance column='[open_requests]' derivation='Sum' name='[sum:open_requests:qk]' pivot='key' type='quantitative' />
<column-instance column='[month_end]' derivation='Month-Trunc' name='[tmn:month_end:qk]' pivot='key' type='quantitative' />
<column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
<column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.bc].[none:request_type:nk]'>
  <groupfilter function='member' level='[none:request_type:nk]' member='"field"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bc].[none:age_band:nk]'>
  <groupfilter function='member' level='[none:age_band:nk]' member='"90+"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
        
        <slices><column>[federated.bc].[none:request_type:nk]</column><column>[federated.bc].[none:age_band:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Line' />
          
        </pane>
      </panes>
      <rows>[federated.bc].[sum:open_requests:qk]</rows>
      <cols>[federated.bc].[tmn:month_end:qk]</cols>
    </table>
  </worksheet>
  <worksheet name="Timeliness by service">
    <layout-options><title><formatted-text><run>Share of closed requests within their own service benchmark (P80 of 2022-2024)</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Timeliness (category_monthly)" name='federated.cm' /></datasources>
        <datasource-dependencies datasource='federated.cm'>
          <column caption="% within benchmark" datatype='real' name='[Calculation_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([closed_within_benchmark]) / SUM([closed_with_benchmark])" /></column>
<column caption="Period" datatype='string' name='[Calculation_period]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [request_month] &lt; #2025-01-01# THEN '2022-2024' ELSEIF [request_month] &lt;= DATEADD('month', -2, {FIXED : MAX([request_month])}) THEN '2025 on' END" /></column>
<column-instance column='[Calculation_pct]' derivation='User' name='[usr:Calculation_pct:qk]' pivot='key' type='quantitative' />
<column-instance column='[service_category]' derivation='None' name='[none:service_category:nk]' pivot='key' type='nominal' />
<column-instance column='[Calculation_period]' derivation='None' name='[none:Calculation_period:nk]' pivot='key' type='nominal' />
<column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.cm].[none:request_type:nk]'>
  <groupfilter function='member' level='[none:request_type:nk]' member='"field"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.cm].[none:Calculation_period:nk]'><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level='[none:Calculation_period:nk]' /><groupfilter function='member' level='[none:Calculation_period:nk]' member='%null%' /></groupfilter></filter>
        
        <slices><column>[federated.cm].[none:request_type:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Bar' />
          <encodings><color column='[federated.cm].[none:Calculation_period:nk]' /></encodings>
        </pane>
      </panes>
      <rows>([federated.cm].[none:service_category:nk] / [federated.cm].[none:Calculation_period:nk])</rows>
      <cols>[federated.cm].[usr:Calculation_pct:qk]</cols>
    </table>
  </worksheet>
  <worksheet name="Old backlog by service">
    <layout-options><title><formatted-text><run>Roads &amp; Mobility holds most of the old work</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Backlog (backlog_category_monthly)" name='federated.bc' /></datasources>
        <datasource-dependencies datasource='federated.bc'>
          <column-instance column='[open_requests]' derivation='Sum' name='[sum:open_requests:qk]' pivot='key' type='quantitative' />
<column-instance column='[service_category]' derivation='None' name='[none:service_category:nk]' pivot='key' type='nominal' />
<column caption="Latest month end" datatype='boolean' name='[Calculation_latest]' role='dimension' type='nominal'><calculation class='tableau' formula="[month_end] = {FIXED : MAX([month_end])}" /></column>
<column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
<column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' />
<column-instance column='[Calculation_latest]' derivation='None' name='[none:Calculation_latest:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.bc].[none:request_type:nk]'>
  <groupfilter function='member' level='[none:request_type:nk]' member='"field"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bc].[none:age_band:nk]'>
  <groupfilter function='member' level='[none:age_band:nk]' member='"90+"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bc].[none:Calculation_latest:nk]'>
  <groupfilter function='member' level='[none:Calculation_latest:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
        <sort class='computed' column='[federated.bc].[none:service_category:nk]' direction='DESC' using='[federated.bc].[sum:open_requests:qk]' />
        <slices><column>[federated.bc].[none:request_type:nk]</column><column>[federated.bc].[none:age_band:nk]</column><column>[federated.bc].[none:Calculation_latest:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Bar' />
          
        </pane>
      </panes>
      <rows>[federated.bc].[none:service_category:nk]</rows>
      <cols>[federated.bc].[sum:open_requests:qk]</cols>
    </table>
  </worksheet>
  <worksheet name="Top communities">
    <layout-options><title><formatted-text><run>Top 12 communities by field requests open 90+ days</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Backlog by community (backlog_community_monthly)" name='federated.bcom' /></datasources>
        <datasource-dependencies datasource='federated.bcom'>
          <column-instance column='[open_requests]' derivation='Sum' name='[sum:open_requests:qk]' pivot='key' type='quantitative' />
<column-instance column='[comm_name]' derivation='None' name='[none:comm_name:nk]' pivot='key' type='nominal' />
<column caption="Latest month end" datatype='boolean' name='[Calculation_latest]' role='dimension' type='nominal'><calculation class='tableau' formula="[month_end] = {FIXED : MAX([month_end])}" /></column>
<column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' />
<column-instance column='[Calculation_latest]' derivation='None' name='[none:Calculation_latest:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.bcom].[none:age_band:nk]'>
  <groupfilter function='member' level='[none:age_band:nk]' member='"90+"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bcom].[none:Calculation_latest:nk]'>
  <groupfilter function='member' level='[none:Calculation_latest:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<filter class='categorical' column='[federated.bcom].[none:comm_name:nk]'><groupfilter count='12' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression='SUM([open_requests])' function='order' user:ui-marker='order'><groupfilter function='level-members' level='[none:comm_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></filter>
        <sort class='computed' column='[federated.bcom].[none:comm_name:nk]' direction='DESC' using='[federated.bcom].[sum:open_requests:qk]' />
        <slices><column>[federated.bcom].[none:age_band:nk]</column><column>[federated.bcom].[none:Calculation_latest:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Bar' />
          
        </pane>
      </panes>
      <rows>[federated.bcom].[none:comm_name:nk]</rows>
      <cols>[federated.bcom].[sum:open_requests:qk]</cols>
    </table>
  </worksheet>
  <worksheet name="Seasonality">
    <layout-options><title><formatted-text><run>Average requests per calendar month: June peaks, February and December are lowest</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Timeliness (category_monthly)" name='federated.cm' /></datasources>
        <datasource-dependencies datasource='federated.cm'>
          <column caption="Requests in month" datatype='integer' name='[Calculation_monthtotal]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [request_month] : SUM([requests])}" /></column>
<column caption="Full month" datatype='boolean' name='[Calculation_fullmonth]' role='dimension' type='nominal'><calculation class='tableau' formula="[request_month] &lt; {FIXED : MAX([request_month])}" /></column>
<column-instance column='[Calculation_monthtotal]' derivation='Avg' name='[avg:Calculation_monthtotal:qk]' pivot='key' type='quantitative' />
<column-instance column='[request_month]' derivation='Month' name='[mn:request_month:ok]' pivot='key' type='ordinal' />
<column-instance column='[Calculation_fullmonth]' derivation='None' name='[none:Calculation_fullmonth:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.cm].[none:Calculation_fullmonth:nk]'>
  <groupfilter function='member' level='[none:Calculation_fullmonth:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
        
        <slices><column>[federated.cm].[none:Calculation_fullmonth:nk]</column></slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Bar' />
          
        </pane>
      </panes>
      <rows>[federated.cm].[avg:Calculation_monthtotal:qk]</rows>
      <cols>[federated.cm].[mn:request_month:ok]</cols>
    </table>
  </worksheet>
  <worksheet name="Snow and requests">
    <layout-options><title><formatted-text><run>Winter 2025-2026: snow requests (top) follow snowfall (bottom) by one to three days</run></formatted-text></title></layout-options>
    <table>
      <view>
        <datasources><datasource caption="Snow (daily_snow_requests)" name='federated.sn' /></datasources>
        <datasource-dependencies datasource='federated.sn'>
          <column-instance column='[snow_requests]' derivation='Sum' name='[sum:snow_requests:qk]' pivot='key' type='quantitative' />
<column-instance column='[snowfall_cm]' derivation='Sum' name='[sum:snowfall_cm:qk]' pivot='key' type='quantitative' />
<column-instance column='[day]' derivation='Day-Trunc' name='[tdy:day:qk]' pivot='key' type='quantitative' />
        </datasource-dependencies>
        
<filter class='quantitative' column='[federated.sn].[tdy:day:qk]' included-values='in-range'><min>#2025-10-01#</min><max>#2026-04-30#</max></filter>
        
        
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view><breakdown value='auto' /></view>
          <mark class='Bar' />
          
        </pane>
      </panes>
      <rows>([federated.sn].[sum:snow_requests:qk] / [federated.sn].[sum:snowfall_cm:qk])</rows>
      <cols>[federated.sn].[tdy:day:qk]</cols>
    </table>
  </worksheet>
  </worksheets>
  <dashboards>
  <dashboard name='Calgary 311 Service Performance'>
    <style />
    <size maxheight='1400' maxwidth='1300' minheight='1400' minwidth='1300' sizing-mode='fixed' />
    <zones>
      <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='7000' id='2' type-v2='text' w='72000' x='0' y='0'><formatted-text><run bold='true' fontsize='14'>Calgary 311 Service Performance. Field crews close new requests as fast as before, except Fire. Old work is the problem: requests open 90+ days are at their highest level since 2022.</run></formatted-text></zone>
<zone h='7000' id='3' name='Headline backlog' show-title='true' w='28000' x='72000' y='0' />
<zone h='29000' id='4' name="Old backlog trend" w='50000' x='0' y='7000' />
<zone h='29000' id='5' name="Timeliness by service" w='50000' x='50000' y='7000' />
<zone h='29000' id='6' name="Old backlog by service" w='50000' x='0' y='36000' />
<zone h='29000' id='7' name="Top communities" w='50000' x='50000' y='36000' />
<zone h='29000' id='8' name="Seasonality" w='50000' x='0' y='65000' />
<zone h='29000' id='9' name="Snow and requests" w='50000' x='50000' y='65000' />
<zone h='6000' id='10' type-v2='text' w='100000' x='0' y='94000'><formatted-text><run fontsize='8'>Source: City of Calgary Open Data (311 Service Requests iahh-g8bj, Community District Boundaries surr-xmvs) and ECCC daily climate data, CALGARY INTL A. Benchmark: each service's own 80th percentile time to close in 2022-2024. 'Closed' means closed in the system, not fixed. Snapshot 2026-11-19.</run></formatted-text></zone>
      </zone>
    </zones>
  </dashboard>
  </dashboards>
